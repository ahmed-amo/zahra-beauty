APP_NAME="BéBé Dome"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Production: https://bebedome-dz.com
FRONTEND_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=bebedome
DB_USERNAME=bebedome
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
CACHE_STORE=database
QUEUE_CONNECTION=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailtrap Email Testing (free sandbox) — Email Testing → Inboxes → SMTP Settings → Laravel
# Copy username + password from https://mailtrap.io (sandbox.smtp.mailtrap.io)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@bebedome.dz"
MAIL_FROM_NAME="${APP_NAME}"

# Private disk for generic Storage:: calls; shop media uses MEDIA_DISK=public.
FILESYSTEM_DISK=local
MEDIA_DISK=public

VITE_APP_NAME="${APP_NAME}"
# Prefer same-origin (leave empty or set to APP_URL). Vite does not expand ${APP_URL}.
VITE_API_URL=http://localhost:8000

# Google OAuth (Web client) — redirect URI must match Google Cloud Console exactly:
#   {APP_URL}/auth/google/callback
# Local example: http://localhost:8000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
# Dev-only: set true if PHP cURL lacks a CA bundle (never in production)
GOOGLE_OAUTH_INSECURE_SSL=false

# Sole super-admin — this account alone can create other admin accounts.
# Run: php artisan db:seed --class=SuperAdminSeeder after setting these in production.
ADMIN_NAME="BéBé Dome Owner"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Facebook OAuth — redirect: {APP_URL}/auth/facebook/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"
